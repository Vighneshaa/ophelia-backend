# MongoDB Atlas connection string (required for DB features)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<app>

# Optional
PORT=3001
# FRONTEND_URL=http://localhost:5173

# Shipping (calculated on backend only; not sent from frontend)
# SHIPPING_FREE_MIN=500   # Free shipping when subtotal >= this (default 500)
# SHIPPING_FLAT_FEE=50    # Flat shipping fee when below min (default 50)
